<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Computator.Performance.Worker</AssemblyName>
    <StartupObject>CompilerComparisonEntryPoint</StartupObject>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize><DebugType>portable</DebugType>
    <IsPackable>false</IsPackable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The byte-identical observer is IL-only in both products. Crossgen never
         bakes one product's dependency assumptions into the shared worker. -->
    <PublishReadyToRunExclude Include="Computator.Performance.Worker.dll" />
    <!-- One common driver uses the unchanged historical workload/oracle source. -->
    <Compile Include="Worker.cs;DesktopStartup.cs;DirectExpressionEntryPoint.cs;CompilerComparisonEntryPoint.cs" />
    <ProjectReference Include="$(ProductSourceDirectory)/Computator.NET.Core/Computator.NET.Core.csproj" />
  </ItemGroup>
  <Target Name="RequirePinnedProduct" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProductSourceDirectory)' == ''" Text="Supply an explicitly pinned ProductSourceDirectory." />
  </Target>
</Project>
