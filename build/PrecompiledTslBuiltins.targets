<Project>
  <!-- Build shipped ToCode bodies once; the three native Coulomb scratch
       outputs are explicitly localized and independently regression-tested. -->
  <UsingTask TaskName="GeneratePrecompiledTslBuiltins" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <!-- Inline tasks target netstandard. Reuse the matching assets already
           restored for the compiler, rather than the SDK's net10-only binaries. -->
      <Reference Include="$(NuGetPackageRoot)/microsoft.codeanalysis.common/$(ComputatorRoslynPackageVersion)/lib/netstandard2.0/Microsoft.CodeAnalysis.dll" />
      <Reference Include="$(NuGetPackageRoot)/microsoft.codeanalysis.csharp/$(ComputatorRoslynPackageVersion)/lib/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll" />
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)GeneratePrecompiledTslBuiltins.cs" />
    </Task>
  </UsingTask>
  <ItemGroup>
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Constants/MathematicalConstants.cs" Kind="MathematicalConstants" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Constants/PhysicalConstants.cs" Kind="PhysicalConstants" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/ElementaryFunctions.cs" Kind="ElementaryFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/SpecialFunctions.cs" Kind="SpecialFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/StatisticsFunctions.cs" Kind="StatisticsFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/NumericalCalculations/Integral.cs" Kind="Integral" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/NumericalCalculations/Derivative.cs" Kind="Derivative" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/NumericalCalculations/FunctionRoot.cs" Kind="FunctionRoot" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/MatrixFunctions.cs" Kind="MatrixFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Evaluation/NumericalExtensions.cs" Kind="NumericalExtensions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/ReadForm.cs" Kind="ReadForm" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/ScriptingFunctions.cs" Kind="ScriptingFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Evaluation/ScriptingExtensionObjects.cs" Kind="ScriptingExtensionObjects" />
  </ItemGroup>
  <Target Name="GenerateTslBuiltinFacade" Inputs="@(_TslBuiltinSource);$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)GeneratePrecompiledTslBuiltins.cs" Outputs="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs">
    <Error Condition="'$(CheckForOverflowUnderflow)' == 'true'" Text="Precompiled TSL builtins require the same unchecked arithmetic policy as NativeCompiler." />
    <GeneratePrecompiledTslBuiltins Sources="@(_TslBuiltinSource)" OutputFile="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs" />
  </Target>
  <Target Name="IncludeTslBuiltinFacade" BeforeTargets="CoreCompile" DependsOnTargets="GenerateTslBuiltinFacade">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs" />
    </ItemGroup>
  </Target>
</Project>
