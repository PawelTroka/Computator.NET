<Project>
  <!-- Build the exact shipped ToCode bodies once; do not maintain another
       implementation of the numerical functions. -->
  <UsingTask TaskName="GeneratePrecompiledTslBuiltins" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" /><Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var fragments = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var sourceItem in Sources)
        {
            string source = File.ReadAllText(sourceItem.ItemSpec);
            var matches = Regex.Matches(source, @"\bpublic\s+const\s+string\s+ToCode\s*=");
            if (matches.Count != 1) throw new InvalidOperationException("Expected exactly one ToCode constant in " + sourceItem.ItemSpec);
            int position = matches[0].Index + matches[0].Length;
            while (position < source.Length && char.IsWhiteSpace(source[position])) position++;
            if (position + 1 >= source.Length || source[position] != '@' || source[position + 1] != '"')
                throw new InvalidOperationException("ToCode must remain a single verbatim literal: " + sourceItem.ItemSpec);
            position += 2;
            var fragment = new StringBuilder();
            bool closed = false;
            while (position < source.Length)
            {
                char character = source[position++];
                if (character != '"') { fragment.Append(character); continue; }
                if (position < source.Length && source[position] == '"') { fragment.Append('"'); position++; continue; }
                closed = true;
                break;
            }
            while (position < source.Length && char.IsWhiteSpace(source[position])) position++;
            if (!closed || position >= source.Length || source[position] != ';')
                throw new InvalidOperationException("Unsupported or unterminated ToCode initializer: " + sourceItem.ItemSpec);
            fragments.Add(sourceItem.GetMetadata("Kind"), fragment.ToString());
        }
        string[] kinds = { "MathematicalConstants", "PhysicalConstants", "ElementaryFunctions", "SpecialFunctions",
            "StatisticsFunctions", "Integral", "Derivative", "FunctionRoot" };
        var common = new List<string>();
        var immutable = new List<string>();
        foreach (string kind in kinds)
        {
            common.Add(fragments[kind]);
            // Statistics owns the replaceable public rnd field. Preserve that
            // entire fragment inside a separately closed per-program generic.
            if (kind != "StatisticsFunctions") immutable.Add(fragments[kind]);
        }
        var script = new List<string>(common); script.Add(fragments["MatrixFunctions"]);
        var scriptImmutable = new List<string>(immutable); scriptImmutable.Add(fragments["MatrixFunctions"]);
        Func<string, string> hash = value => {
            using (var sha = SHA256.Create())
                return BitConverter.ToString(sha.ComputeHash(Encoding.UTF8.GetBytes(value))).Replace("-", "").ToLowerInvariant();
        };
        var generated = new StringBuilder();
        generated.AppendLine("// <auto-generated />");
        generated.AppendLine("#nullable disable");
        generated.AppendLine("#pragma warning disable CS8981 // Existing TSL type aliases.");
        generated.AppendLine("using real = System.Double; using complex = System.Numerics.Complex; using natural = System.UInt64; using integer = System.Int64;");
        generated.AppendLine("using MathNet.Numerics.Distributions;");
        generated.AppendLine("namespace Computator.NET.Core.Compilation.Builtins {");
        // Native imports remain unchanged in nongeneric surfaces. The policy
        // verifies that these surfaces contain no mutable authored static state.
        generated.AppendLine("[System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]");
        generated.AppendLine("public class PrecompiledExpressionSurface {");
        foreach (string fragment in immutable) generated.AppendLine(fragment);
        generated.AppendLine("}");
        // Scalar and matrix pow overloads must be declared together.
        generated.AppendLine("[System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]");
        generated.AppendLine("public class PrecompiledScriptMathSurface {");
        foreach (string fragment in scriptImmutable) generated.AppendLine(fragment);
        generated.AppendLine("}");
        generated.AppendLine("[System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]");
        generated.AppendLine("public class PrecompiledExpressionBuiltins<TProgram> : PrecompiledExpressionSurface {");
        generated.AppendLine(fragments["StatisticsFunctions"]);
        generated.AppendLine("}");
        generated.AppendLine("[System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]");
        generated.AppendLine("public class PrecompiledScriptMathBuiltins<TProgram> : PrecompiledScriptMathSurface {");
        generated.AppendLine(fragments["StatisticsFunctions"]);
        generated.AppendLine("}");
        generated.AppendLine(fragments["NumericalExtensions"]);
        generated.AppendLine("public static class PrecompiledBuiltinSourceHashes {");
        generated.AppendLine("public const string Expression = \"" + hash(string.Join("\0", common)) + "\";");
        generated.AppendLine("public const string ScriptMath = \"" + hash(string.Join("\0", script)) + "\";");
        generated.AppendLine("public const string NumericalExtensions = \"" + hash(fragments["NumericalExtensions"]) + "\";");
        generated.AppendLine("} }");
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        string text = generated.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
            File.WriteAllText(OutputFile, text, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <ItemGroup>
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Constants/MathematicalConstants.cs" Kind="MathematicalConstants" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Constants/PhysicalConstants.cs" Kind="PhysicalConstants" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/ElementaryFunctions.cs" Kind="ElementaryFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/SpecialFunctions.cs" Kind="SpecialFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/StatisticsFunctions.cs" Kind="StatisticsFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/NumericalCalculations/Integral.cs" Kind="Integral" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/NumericalCalculations/Derivative.cs" Kind="Derivative" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/NumericalCalculations/FunctionRoot.cs" Kind="FunctionRoot" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Functions/MatrixFunctions.cs" Kind="MatrixFunctions" />
    <_TslBuiltinSource Include="$(MSBuildThisFileDirectory)../Computator.NET.Core/Evaluation/NumericalExtensions.cs" Kind="NumericalExtensions" />
  </ItemGroup>
  <Target Name="GenerateTslBuiltinFacade" Inputs="@(_TslBuiltinSource);$(MSBuildThisFileFullPath)"
          Outputs="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs">
    <Error Condition="'$(CheckForOverflowUnderflow)' == 'true'" Text="Precompiled TSL builtins require the same unchecked arithmetic policy as NativeCompiler." />
    <GeneratePrecompiledTslBuiltins Sources="@(_TslBuiltinSource)" OutputFile="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs" />
  </Target>
  <Target Name="IncludeTslBuiltinFacade" BeforeTargets="CoreCompile" DependsOnTargets="GenerateTslBuiltinFacade">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PrecompiledTslBuiltins.g.cs" />
    </ItemGroup>
  </Target>
</Project>
