<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\ModernDesktop.props" />
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Satellite .resx files are embedded, never regenerated as duplicate C#.
         The neutral resources retain the public designers checked into source. -->
    <Compile Update="**\*.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <EmbeddedResource Update="Strings.resx;Charting\EditChart3DWindow.resx;Charting\EditChartProperties.resx;Charting\EditChartWindow.resx;Charting\EditComplexChartWindow.resx;Dialogs\BenchmarkForm.resx;Dialogs\SettingsForm.resx;Menu\MenuStrings.resx;Views\CalculationsView.resx;Views\ChartAreaValuesView.resx;Views\ExpressionView.resx;Views\MainView.resx;Views\NumericalCalculationsView.resx;Views\ScriptingView.resx;Views\SolutionExplorerView.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>%(Filename).Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
