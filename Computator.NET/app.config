<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <appSettings>
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </appSettings>
  <runtime>
    <AppContextSwitchOverrides value="Switch.UseLegacyAccessibilityFeatures=false;Switch.System.IO.UseLegacyPathHandling=false" />
    <!-- Binding redirects are generated from the restored dependency graph.
         Do not pin obsolete 2014 BCL portable assembly identities here. -->
  </runtime>
</configuration>
