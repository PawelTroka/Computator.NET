    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>Computator.NET</RootNamespace>
    <AssemblyName>Computator.NET</AssemblyName>
