  <ItemGroup>
    <ProjectReference Include="..\Computator.NET.Core\Computator.NET.Core.csproj" />
    <ProjectReference Include="..\Computator.NET.Desktop\Computator.NET.Desktop.csproj" />
  </ItemGroup>
</Project>
