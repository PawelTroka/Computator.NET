<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\ModernDesktop.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>Computator.NET</RootNamespace>
    <AssemblyName>Computator.NET</AssemblyName>
    <ApplicationIcon>..\Graphics\computator.net-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Precompile the application and its distributed compiler dependencies.
         IL remains available: TSL/Roslyn and collectible programs still work.
         An explicit false override preserves an IL-only diagnostic publish. -->
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Computator.NET.Core\Computator.NET.Core.csproj" />
    <ProjectReference Include="..\Computator.NET.Desktop\Computator.NET.Desktop.csproj" />
  </ItemGroup>
</Project>
