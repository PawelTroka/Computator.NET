<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;dist/**;playwright-report/**;test-results/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SharedAssemblyInfo.cs" Link="Properties/SharedAssemblyInfo.cs" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <!-- Only Vite's production output belongs in the deployed web root. -->
    <Content Remove="ClientApp/**;wwwroot/**;package*.json;tsconfig.json;tests/**" />
    <None Update="package*.json;tsconfig.json;vite.config.ts;playwright.config.ts;tests/**;ClientApp/**;wwwroot/**" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/dist/index.html')" Text="Frontend output is missing. Run npm ci and npm run build before using SkipFrontendBuild." />
    <ItemGroup>
      <FrontendOutput Include="$(MSBuildProjectDirectory)/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendOutput->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>dist/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
