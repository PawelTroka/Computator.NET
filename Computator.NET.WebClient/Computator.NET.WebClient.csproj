<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules/**;dist/**;playwright-report/**;test-results/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SharedAssemblyInfo.cs" Link="Properties/SharedAssemblyInfo.cs" />
    <Compile Include="../Shared/OwnedProcessJob.cs" Link="Hosting/OwnedProcessJob.cs" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <Content Remove="ClientApp/**;wwwroot/**;package*.json;tsconfig.json;tests/**" />
    <!-- The Web SDK removes its default Content items from None before the
         removal above. Include them again so Rider/VS can see the source inputs;
         only Vite's dist output belongs in the published application. -->
    <None Include="package*.json;tsconfig.json;wwwroot/**" Exclude="@(None)"
          CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="package-lock.json" DependentUpon="package.json" />
    <None Update="package*.json;tsconfig.json;vite.config.ts;playwright.config.ts;tests/**;ClientApp/**;wwwroot/**" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <!-- A direct dotnet publish uses the same Cake frontend task as CI. Cake's
         Web-Publish supplies SkipFrontendBuild after Web-Build, avoiding recursion. -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/.." Command="dotnet tool restore" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/.." Command="dotnet cake build.cake --target=Web-Build" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/dist/index.html')" Text="Frontend output is missing. Run the Cake Web-Build target before using SkipFrontendBuild." />
    <ItemGroup>
      <FrontendOutput Include="$(MSBuildProjectDirectory)/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendOutput->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>dist/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
