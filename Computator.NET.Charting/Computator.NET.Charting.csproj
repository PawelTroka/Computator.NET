<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\ModernDesktop.props" />
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- This binary is not claimed to be compatible with the .NET 10 runtime. -->
    <Reference Include="Microsoft.VisualBasic.PowerPacks.Vs">
      <HintPath>..\libraries\Microsoft.VisualBasic.PowerPacks.Vs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <PackageReference Include="NLog" />
    <ProjectReference Include="..\Computator.NET.DataTypes\Computator.NET.DataTypes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWPF supplies the Page item; Include would compile this twice. -->
    <Page Update="Chart3D\UI\Chart3DControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Remove="Chart3D\UI\Chart3DControlMono.cs" />
  </ItemGroup>
</Project>
