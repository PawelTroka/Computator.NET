<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\ModernDesktop.props" />
  <Import Project="..\build\PrecompiledTslBuiltins.targets" />
  <PropertyGroup><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WinForms.DataVisualization" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Accord.Math" /><PackageReference Include="Guards" />
    <PackageReference Include="MathNet.Numerics" /><PackageReference Include="Meta.Numerics" /><PackageReference Include="Unity" />
    <ProjectReference Include="..\Computator.NET.DataTypes\Computator.NET.DataTypes.csproj" />
    <!-- ScriptEvaluator compiles against Charting even when its host uses no charts. -->
    <ProjectReference Include="..\Computator.NET.Charting\Computator.NET.Charting.csproj" />
    <ProjectReference Include="..\Computator.NET.Engine\Computator.NET.Engine.csproj" />
    <Compile Remove="Compilation\TSLCompiler.cs;Compilation\TslHandlers\*.cs;Constants\MathematicalConstants.cs" />
    <Compile Remove="Functions\MatrixFunctions.cs;Evaluation\NumericalExtensions.cs;NumericalCalculations\Integral.cs;NumericalCalculations\Derivative.cs;NumericalCalculations\FunctionRoot.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Static\functions.xml;Static\reference-equations\**\*;Static\TSL-Syntax.xshd;Static\TSL-Syntax_old.xshd;TSL Examples\**\*.tsl;TSL Examples\**\*.tslf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\CHANGELOG" Link="CHANGELOG"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Compile Update="Compilation\NativeCompiler.cs" SubType="Component" /><Compile Update="Functions\ReadForm.cs" SubType="Form" />
  </ItemGroup>
</Project>
